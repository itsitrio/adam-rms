{# The add/change form for a liability. Open it with liabilityOpen({...fields}, title) #}
<div class="modal fade" id="liabilityModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="liabilityModalTitle">Add a loan or finance</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <form id="liabilityForm">
                    <input type="hidden" name="liabilities_id" value=""/>
                    <div class="form-row">
                        <div class="form-group col-md-7"><label for="liabilityName">Name</label><input type="text" class="form-control" id="liabilityName" name="liabilities_name" maxlength="200" placeholder="e.g. Van loan, Console bought on finance" required/></div>
                        <div class="form-group col-md-5">
                            <label for="liabilityType">Kind</label>
                            <select class="form-control" id="liabilityType" name="liabilities_type">{% for key, name in types %}<option value="{{ key }}">{{ name }}</option>{% endfor %}</select>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-6"><label for="liabilityLender">Owed to</label><input type="text" class="form-control" id="liabilityLender" name="liabilities_lender" maxlength="200" placeholder="Bank, finance company or supplier"/></div>
                        <div class="form-group col-md-6">
                            <label for="liabilityMember">Or a member of the business</label>
                            <select class="form-control" id="liabilityMember" name="users_userid">
                                <option value="">Not a member</option>
                                {% for member in members %}<option value="{{ member.users_userid }}">{{ member.users_name1 }} {{ member.users_name2 }}</option>{% endfor %}
                            </select>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label for="liabilityAmount">Amount borrowed</label>
                            <div class="input-group"><div class="input-group-prepend"><span class="input-group-text">{{ moneySymbol() }}</span></div><input type="text" inputmode="decimal" autocomplete="off" class="form-control" id="liabilityAmount" name="liabilities_amount" required/></div>
                        </div>
                        <div class="form-group col-md-4"><label for="liabilityStart">Started</label><input type="date" class="form-control" id="liabilityStart" name="liabilities_startDate" required/></div>
                        <div class="form-group col-md-4">
                            <label for="liabilityRate">Interest rate</label>
                            <div class="input-group"><input type="number" step="0.001" min="0" class="form-control" id="liabilityRate" name="liabilities_interestRate" placeholder="Optional"/><div class="input-group-append"><span class="input-group-text">% a year</span></div></div>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label for="liabilityRepayment">Regular repayment</label>
                            <div class="input-group"><div class="input-group-prepend"><span class="input-group-text">{{ moneySymbol() }}</span></div><input type="text" inputmode="decimal" autocomplete="off" class="form-control" id="liabilityRepayment" name="liabilities_repaymentAmount" placeholder="Optional"/></div>
                        </div>
                        <div class="form-group col-md-4">
                            <label for="liabilityFrequency">Paid</label>
                            <select class="form-control" id="liabilityFrequency" name="liabilities_repaymentFrequency">{% for key, name in frequencies %}<option value="{{ key }}">{{ name }}</option>{% endfor %}</select>
                        </div>
                        <div class="form-group col-md-4"><label for="liabilityFirst">First repayment</label><input type="date" class="form-control" id="liabilityFirst" name="liabilities_firstRepaymentDate"/></div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-4"><label for="liabilityEnd">To be paid off by</label><input type="date" class="form-control" id="liabilityEnd" name="liabilities_endDate"/></div>
                        <div class="form-group col-md-8"><label for="liabilityReference">Reference or account number</label><input type="text" class="form-control" id="liabilityReference" name="liabilities_reference" maxlength="200"/></div>
                    </div>
                    <div class="form-group"><label for="liabilityNotes">Notes</label><textarea class="form-control" id="liabilityNotes" name="liabilities_notes" rows="2"></textarea></div>
                    <div class="text-danger small formMissing mb-2" style="display: none;">Fill in the boxes marked in red.</div>
                    <small class="text-muted">The regular repayment, how often it's paid and the first repayment date give the schedule of repayments due. Record each repayment as it's made.</small>
                </form>
            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="liabilitySave">Save</button>
            </div>
        </div>
    </div>
</div>
<script>
    function liabilityOpen(liability, title) {
        var form = $("#liabilityForm");
        form[0].reset();
        form.find(".is-invalid").removeClass("is-invalid");
        form.find(".formMissing").hide();
        $.each(liability, function (name, value) { form.find("[name='" + name + "']").val(value === null ? "" : value); });
        $("#liabilityModalTitle").text(title);
        $("#liabilityModal").modal("show");
    }
    $(document).ready(function () {
        $("#liabilitySave").on("click", function () {
            var missing = $("#liabilityForm").find("[required]").removeClass("is-invalid").filter(function () { return $.trim(this.value) === ""; });
            $("#liabilityForm").find(".formMissing").toggle(missing.length > 0);
            if (missing.length > 0) { missing.addClass("is-invalid").first().focus(); return; }
            var data = {};
            $.each($("#liabilityForm").serializeArray(), function (i, field) { data[field.name] = field.value; });
            ajaxcall("reports/liabilities/save.php", data, function (result) {
                window.location.href = "{{ CONFIG.ROOTURL }}/reports/liability.php?id=" + result.response.liabilities_id;
            }, false);
        });
    });
</script>
