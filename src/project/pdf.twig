<!doctype html>
<html lang='en'>
<head>
    <meta charset='utf-8'>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.6/pdfmake.min.js" integrity="sha512-7BzHjLXs8xehClrkJEtJtAwXxcbLast87k+XekuItHxrMr/v6POWkoKS2/8CU6DHdIjY+A4NwvsBQ8PxoRH7xQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.6/vfs_fonts.min.js" integrity="sha512-P0bOMePRS378NwmPDVPU455C/TuxDS+8QwJozdc7PGgN8kLqR4ems0U/3DeJkmiE31749vYWHvBOtR+37qDCZQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
    window.addEventListener("DOMContentLoaded", function () {
        //How many pages the cover takes: one, and one more for each new page its text asks for
        var coverPages = {{ GET['coverPage'] ? 1 + COVERTEXT|filter(node => node.pageBreak is defined)|length : 0 }};
        var docDefinition = {
            content: [
                {% if GET['coverPage'] %}
                    {% include 'project/twigIncludes/pdfCover.twig' %}
                {% endif %}
                {% if CHILDREN|length > 0 %}
                    {% include 'project/twigIncludes/pdfSummary.twig' %}
                    { text: "", pageBreak: 'after' },
                {% endif %}
                {% include 'project/twigIncludes/pdfProject.twig' %}
                {% for child in CHILDREN %}
                    { text: "", pageBreak: 'after' },
                    {% include 'project/twigIncludes/pdfProject.twig' with {"project": child.project, "FINANCIALS": child.FINANCIALS} %}
                {% endfor %}
            ],
            header: function(currentPage) { 
                //Never on the cover, which can be more than one page; the page after it is the first
                if (currentPage <= coverPages) return null;
                if (currentPage === coverPages + 1 && !{{ DOCUMENTS.firstPage ? 'true' : 'false' }}) return null;
                return {
                    columns: [
                        {text: "{{ (DOCUMENTS.headerText != "" ? DOCUMENTS.headerText : USERDATA['instance']['instances_name'])|escape("js") }}", width: "40%"},
                        {text: "{{ GET['fileType']|escape("js") }}", alignment: 'center', width: "20%"},
                        { text: "{% if project.projectsTypes_config_client == 1 and project['clients_name'] %}{{  project['clients_name']|escape("js") }} - {% endif %}{{ project['projects_name']|escape("js") }}", alignment: 'right', width: "40%"}
                    ]
                    , margin: [40, 20, 40, 20]
                };           
            },
            footer: function(currentPage, pageCount) { 
                //Never on the cover, which can be more than one page; the page after it is the first
                if (currentPage <= coverPages) return null;
                if (currentPage === coverPages + 1 && !{{ DOCUMENTS.firstPage ? 'true' : 'false' }}) return null;
                return {
                    columns: [
                        {text: "{{ "now"|date(DOCUMENTS.dateTimeFormat)|escape("js") }}", width: "40%"},
                        {text: currentPage.toString() + '/' + pageCount, alignment: 'center', width: "20%"},
                        {text: "{{ (DOCUMENTS.footerText != "" ? DOCUMENTS.footerText : "Generated by AdamRMS")|escape("js") }}", alignment: 'right', width: "40%" }]
                    , margin: [40, 20, 40, 20]
                }; 
            },
            {% if GET['draft'] %}watermark: { text: 'DRAFT', opacity: 0.2, bold: true, italics: false },{% endif %}
            pageSize: '{{ DOCUMENTS.pageSize == 'LETTER' ? 'LETTER' : 'A4' }}',
            pageOrientation: 'portrait',
            pageMargins: [ 40, 40, 40, 40 ],
            info: {
                title: "{% if project.projectsTypes_config_client == 1 and project['clients_name'] %}{{  project['clients_name']|escape("js") }} - {% endif %}{{ project['projects_name']|escape("js") }}",
                author: "{{ USERDATA['instance']['instances_name']|escape("js") }}",
                subject: "{{ project['projects_name']|escape("js") }}",
                keywords: 'AdamRMS',
            },
            compress: true,
        };
        try {
            var pdf = pdfMake.createPdf(docDefinition);
            {% if PREVIEW %}
            pdf.getBlob((blob) => {
                document.body.innerHTML = '<iframe id="pdfPreview" style="position:fixed;top:0;left:0;width:100%;height:100%;border:0;"></iframe>';
                document.getElementById("pdfPreview").src = URL.createObjectURL(blob) + "#toolbar=0&navpanes=0&view=FitH";
                document.body.dataset.previewBytes = blob.size;
            });
            {% elseif GET['draft'] or CONFIG.FILES_ENABLED != "Enabled" or USERDATA.instance.instances_storageEnabled != 1 %}
            pdf.download("{{ project['projects_name']|escape("js") }} - Draft {{ GET['fileType']|escape("js") }}.pdf", function() {
                // Firefox takes a bit longer to do file actions, so delay closing this tab a little
                setTimeout(() => {window.close()}, 100)
            });
            {% else %}
            pdf.getBlob((blob) => {
                var formData = new FormData();
                formData.append("file", blob, {type: "application/pdf"});
                formData.append("type","{{ GET['type'] }}");
                formData.append("fileNumber", "{{ fileNumber|escape("js") }}");
                formData.append("id", "{{ project['projects_id'] }}");
                var oReq = new XMLHttpRequest();
                oReq.open("POST", "{{CONFIG.ROOTURL}}/api/s3files/uploadProjectInvoice.php", true);
                oReq.onload = function (oEvent) {
                    var response = JSON.parse(oReq.responseText);
                    console.log(response)
                    if (response.error && response.error.code && response.error.code == "AUTH") {
                        //They need to login again - token probably expired
                        location.reload();
                    } else if (response.error && response.error.code) {
                        alert(response.error.message);
                    } else if (response.result && response.response && response.response.url) {
                        //Download the file that was just stored. Making the PDF a second time doesn't give the same
                        //document: pdfmake moves the lines it has already drawn (the accent rule, signature lines)
                        var link = document.createElement("a");
                        link.href = URL.createObjectURL(blob);
                        link.download = "{{ project['projects_name']|escape("js") }} - {{ GET['fileType']|escape("js") }} v{{ fileNumber|escape("js") }}.pdf";
                        document.body.appendChild(link);
                        link.click();
                        // Firefox takes a bit longer to do file actions, so delay closing this tab a little
                        setTimeout(() => {window.close()}, 500);
                    } else {
                        alert("Error loading PDF");
                    }
                };
                oReq.onerror = function(error) {
                    alert("Error creating invoice");
                }
                oReq.send(formData);
            });
            {% endif %}
        } catch(err) {
            alert(err.message);
        }
    });
    </script>
</head>
<body>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pace/1.0.2/pace.min.js" integrity="sha256-EPrkNjGEmCWyazb3A/Epj+W7Qm2pB9vnfXw+X6LImPM=" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="{{ CONFIG.ROOTURL }}/static-assets/libs/pace/pace.css">
    <!--Pace Loader-->
    <script>
        window.paceOptions = {
            startOnPageLoad: false,
            document: false,
            eventLag: false,
            ajax: false,
        };
        Pace.start();
    </script>
    Generating PDF, please wait...
</body>
</html>