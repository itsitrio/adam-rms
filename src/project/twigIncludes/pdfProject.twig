{# One project's part of a PDF - pdf.twig shows it for the project, then for each of its sub-projects if asked to #}
    {% if INSTANCELOGO %}
    {
        image: "{{ INSTANCELOGO|escape("js") }}",
        width: {{ DOCUMENTS.logoWidth }},
        alignment: '{{ DOCUMENTS.logoAlign }}',
        margin: [0, 0, 0, 20]
    },
    {% endif %}
    {
        columns: [
            {
                stack: [
                    {% if project.projectsTypes_config_client == 1 %}
                        {
                            text: "{{ project.clients_name|escape("js") }}",
                            style: { bold: true}
                        },
                        {% if GET['addresses'] %}
                            "{{ project.clients_address|escape("js") }}",
                            " ",
                            "{{ project.clients_website|escape("js") }}",
                            "{{ project.clients_email|escape("js") }}",
                            "{{ project.clients_phone|escape("js") }}"
                        {% endif %}
                    {% endif %}
                ],
                width: "50%"
            },
            {
                stack: [
                    {
                        text: "{{ USERDATA['instance']['instances_name']|escape("js") }}",
                        style: { bold: true}
                    },
                    {% if GET['addresses'] %}
                        "{{ USERDATA.instance.instances_address|escape("js") }}",
                        " ",
                        "{{ USERDATA.instance.instances_website|escape("js") }}",
                        "{{ USERDATA.instance.instances_phone|escape("js") }}",
                        "{{ USERDATA.instance.instances_email|escape("js") }}",
                    {% endif %}
                ],
                style: { alignment: "right" },
                width: "50%"
            }
        ],
    },
    " ",
    {% if GET['pmdetails'] %}
        { text: "{{ project.projects_manager_name|escape("js") }}", style: { bold: true, alignment: "right" } },
        {text: "{{ project.projects_manager_email|escape("js") }}", style: { alignment: "right" } },
    {% endif %}
    {% if fileNumber %}
        {text: "{{ (DOCUMENTS.reference[documentType] ?: "v{version}")|replace({"{project}": project.projects_id, "{version}": fileNumber})|escape("js") }}", style: { alignment: "right" } },
    {% endif %}
    " ",
    { text: "{{ project.projects_name|escape("js") }}", style: { bold: true, fontSize: 25 } },
    { text: "{{ GET['fileType']|escape("js") }}", style: { fontSize: 16 } },
    {% if DOCUMENTS.accentColour %}
        { canvas: [ { type: 'line', x1: 0, y1: 4, x2: {{ DOCUMENTS.contentWidth }}, y2: 4, lineWidth: 2, lineColor: '{{ DOCUMENTS.accentColour }}' } ] },
    {% endif %}
    {
        table: {
            widths: [ "50%", "50%"],
            body: [[
                {
                    table: {
                        body: [
                            [{{ (DOCUMENTS.labels.reference ~ ':')|jsString }},"{{project.projects_id|escape("js")}}"],
                            {% if project.projects_dates_deliver_start %}
                                [{{ (DOCUMENTS.labels.deliver ~ ':')|jsString }},"{{ project.projects_dates_deliver_start|date(DOCUMENTS.dateTimeFormat)|escape("js")}}"],
                            {% endif %}
                            {% if project.projects_dates_use_start %}
                                [{{ (DOCUMENTS.labels.start ~ ':')|jsString }},"{{ project.projects_dates_use_start|date(DOCUMENTS.dateTimeFormat)|escape("js")}}"],
                            {% endif %}
                            {% if project.projects_dates_use_end %}
                                [{{ (DOCUMENTS.labels.finish ~ ':')|jsString }},"{{ project.projects_dates_use_end|date(DOCUMENTS.dateTimeFormat)|escape("js") }}"],
                            {% endif %}
                            {% if project.projects_dates_deliver_end %}
                                [{{ (DOCUMENTS.labels.collect ~ ':')|jsString }},"{{ project.projects_dates_deliver_end|date(DOCUMENTS.dateTimeFormat)|escape("js") }}"],
                            {% endif %}
                            {% if GET['totalmass'] and project.projectsTypes_config_assets == 1 %}
                                [{{ (DOCUMENTS.labels.massEstimate ~ ':')|jsString }},"{{FINANCIALS.mass|mass|escape("js") }}"],
                            {% endif %}
                            {% if GET['totalvalue'] and project.projectsTypes_config_assets == 1 %}
                                [{{ (DOCUMENTS.labels.valueEstimate ~ ':')|jsString }},"{{FINANCIALS.value|money|escape("js") }}"],
                            {% endif %}
                        ],
                    },
                    layout: 'noBorders',
                    margin: 10
                },
                {% if GET['venue'] and project.projectsTypes_config_venue == 1 and project.locations_name %}
                {
                    stack: [
                        { text: {{ DOCUMENTS.labels.venue|jsString }}, style: {bold: true}},
                        "{{ project.locations_name|escape("js") }}",
                        "{{ project.locations_address|escape("js") }}"
                    ],
                    style: { alignment: "right" },
                    margin: 10
                },
                {% else %}
                { text: "" },{# So the box is still the width of the page #}
                {% endif %}
            ]],
        },
        fillColor: '#F5F5F5',
        layout: 'noBorders',
        margin: [ 0, 10, 0, 10 ]
    },
    {% if DOCUMENTS.intro[documentType] != "" %}
        { text: {{ DOCUMENTS.intro[documentType]|jsString }}, margin: [ 0, 0, 0, 10 ] },
    {% endif %}
    {% if project.projects_invoiceNotes|length > 0 and GET['invoiceNotes'] %}
        { text: {{ DOCUMENTS.labels.notes|jsString }}, style: { fontSize: 20, bold: true } },
        "{{ project.projects_invoiceNotes|escape("js") }}",
    {% endif %}
    {% if project.projects_deliveryNotes|length > 0 and GET['type'] == 'deliveryNote' %}
        { text: "{{ (DOCUMENTS.names.deliveryNote != "" ? DOCUMENTS.names.deliveryNote ~ " Notes" : "Delivery Notes")|escape("js") }}", style: { fontSize: 20, bold: true }, margin: [ 0, 20, 0, 0 ] },
        "{{ project.projects_deliveryNotes|escape("js") }}",
    {% endif %}
    {% if GET['assets'] and project.projectsTypes_config_assets == 1 %}
        { text: {{ DOCUMENTS.labels.equipment|jsString }}, style: { fontSize: 20, bold: true }, pageBreak: 'before' },

        {% set columnCount = 2 %}
        {% set priceColumnCount = 0 %}
        {% if GET['checkboxes'] %}{% set columnCount = columnCount + 1 %}{% endif %}
        {% if GET['comments'] %}{% set columnCount = columnCount + 1 %}{% endif %}
        {% if GET['masses'] %}{% set columnCount = columnCount + 1 %}{% endif %}
        {% if project.projectsTypes_config_finance == 1 %}
            {% if GET['prices'] %}{% set priceColumnCount = priceColumnCount + 1 %}{% endif %}
            {% if GET['discounts'] %}{% set priceColumnCount = priceColumnCount + 1 %}{% endif %}
        {% endif %}
        {% set columnCount = columnCount + priceColumnCount %}
        {% set tableWidths %}[
            {% if GET['checkboxes'] %}'auto',{% endif %}
            '*',
            {% if GET['comments'] %}'auto',{% endif %}
            'auto',
            {% if GET['masses'] %}'auto',{% endif %}
            {% if project.projectsTypes_config_finance == 1 %}
                {% if GET['prices'] %}'auto',{% endif %}
                {% if GET['discounts'] %}'auto',{% endif %}
            {% endif %}
        ]{% endset %}
        {% set tableHeader %}[
            {% if GET['checkboxes'] %}' ',{% endif %}
            {{ DOCUMENTS.labels.item|jsString }},
            {% if GET['comments'] %}' ',{% endif %}
            '{# Definable Fields #} ',
            {% if GET['masses'] %}{{ DOCUMENTS.labels.mass|jsString }},{% endif %}
            {% if project.projectsTypes_config_finance == 1 %}
                {% if GET['prices'] %}{{ (DOCUMENTS.labels.price ~ ' ' ~ moneySymbol())|jsString }},{% endif %}
                {% if GET['discounts'] %}{{ (DOCUMENTS.labels.discount ~ ' ' ~ moneySymbol())|jsString }},{% endif %}
            {% endif %}
        ],{% endset %}

        {# The project's own headings, in the order it gives them #}
        {% for section in FINANCIALS.quote.sections %}{% if section.types|length > 0 or section.lines|length > 0 %}
            {
                table: {
                    headerRows: 2,
                    widths: {{ tableWidths }},
                    body: [
                        [{
                            text: "{{ section.projectsQuoteSections_name|escape("js") }}",
                            style: { bold: true, fontSize: 14 },
                            fillColor: '{{ DOCUMENTS.accentColour ?: '#E8E8E8' }}',
                            color: '{{ DOCUMENTS.accentText }}',
                            colSpan: {{ columnCount }},
                            margin: 3
                        },
                        {% for i in range(2, columnCount) %}{},{% endfor %}
                        ],
                        {{ tableHeader }}
                        {% for type in section.types %}
                            {% embed 'project/twigIncludes/assetList/tableItemPDF.twig' with {"type": type} %}{% endembed %}
                        {% endfor %}
                        {% for line in section.lines %}
                            {% include 'project/twigIncludes/assetList/lineItemPDF.twig' %}
                        {% endfor %}
                        {% if priceColumnCount > 0 %}
                            [
                                {
                                    text: "{{ section.projectsQuoteSections_name|escape("js") }} Total",
                                    style: { bold: true, alignment: 'right' },
                                    colSpan: {{ columnCount - priceColumnCount }}
                                },
                                {% for i in range(2, columnCount - priceColumnCount) %}{},{% endfor %}
                                {% if GET['prices'] %}{ text: '{{ section.totals.price|money|escape("js") }}', style: { bold: true } },{% endif %}
                                {% if GET['discounts'] %}{ text: '{{ section.totals.discountPrice|money|escape("js") }}', style: { bold: true } },{% endif %}
                            ],
                        {% endif %}
                    ],
                },
                layout: 'lightHorizontalLines',
                margin: [ 0, 10, 0, 10 ]
            },
        {% endif %}{% endfor %}

        {# Everything not under a heading, under its asset category #}
        {% if FINANCIALS.quote.unsectioned|length > 0 %}
            {
                table: {
                    headerRows: 1,
                    widths: {{ tableWidths }},
                    body: [
                        {{ tableHeader }}
                    {% set currentCategory = "" %}
                    {% for type in FINANCIALS.quote.unsectioned %}
                        {% if type['assets'][0].assetCategories_name != currentCategory %}
                            {% set currentCategory = type['assets'][0].assetCategories_name %}
                            [{
                                text: "{{ type['assets'][0].assetCategories_name|escape("js") }}",
                                style: { bold: true },
                                fillColor: '#F5F5F5',
                                colSpan: {{ columnCount }},
                                margin: 3
                            },
                            {% for i in range(2, columnCount) %}{},{% endfor %}
                        ],
                        {% endif %}
                        {% embed 'project/twigIncludes/assetList/tableItemPDF.twig' with {"type": type} %}{% endembed %}
                    {% endfor %}
                    ],
                },
                layout: 'lightHorizontalLines',
                margin: [ 0, 10, 0, 10 ]
            },
        {% endif %}
        {% if FINANCIALS.quote.unsectionedSUB|length > 0 %}{% for instance in FINANCIALS.quote.unsectionedSUB %}
            { text: "{{ instance['instance']['instances_name']|escape("js") }} Equipment", style: { fontSize: 20, bold: true }, pageBreak: 'before' },
            {
                table: {
                    headerRows: 1,
                    widths: {{ tableWidths }},
                    body: [
                        {{ tableHeader }}
                    {% set currentCategory = "" %}
                    {% for type in instance['assets'] %}
                        {% if type['assets'][0].assetCategories_name != currentCategory %}
                            {% set currentCategory = type['assets'][0].assetCategories_name %}
                            [{
                                text: "{{ type['assets'][0].assetCategories_name|escape("js") }}",
                                style: { bold: true },
                                fillColor: '#F5F5F5',
                                colSpan: {{ columnCount }},
                                margin: 3
                            },
                            {% for i in range(2, columnCount) %}{},{% endfor %}
                        ],
                        {% endif %}
                        {% embed 'project/twigIncludes/assetList/tableItemPDF.twig' with {"type": type} %}{% endembed %}
                    {% endfor %}
                    ],
                },
                layout: 'lightHorizontalLines',
                margin: [ 0, 10, 0, 10 ]
            },
        {% endfor %}{% endif %}

        {# Note lines that aren't under a heading #}
        {% if FINANCIALS.quote.lines|length > 0 %}
            {
                table: {
                    headerRows: 1,
                    widths: {{ tableWidths }},
                    body: [
                        [{
                            text: {{ DOCUMENTS.labels.otherItems|jsString }},
                            style: { bold: true, fontSize: 14 },
                            fillColor: '{{ DOCUMENTS.accentColour ?: '#E8E8E8' }}',
                            color: '{{ DOCUMENTS.accentText }}',
                            colSpan: {{ columnCount }},
                            margin: 3
                        },
                        {% for i in range(2, columnCount) %}{},{% endfor %}
                        ],
                        {% for line in FINANCIALS.quote.lines %}
                            {% include 'project/twigIncludes/assetList/lineItemPDF.twig' %}
                        {% endfor %}
                    ],
                },
                layout: 'lightHorizontalLines',
                margin: [ 0, 10, 0, 10 ]
            },
        {% endif %}
        {% if GET['flagsBlocks'] %}{ text: "[F] indicates asset flagged, [B] indicates asset blocked" },{% endif %}
        { text: "[L] indicates asset linked to another" },
        { text: "{{ FINANCIALS.quote.typeCount }} {% if DOCUMENTS.labels.totalItems == 'Total Items' %}Total Item{{ FINANCIALS.quote.typeCount != 1 ? 's' }}{% else %}{{ DOCUMENTS.labels.totalItems|escape("js") }}{% endif %}", style: { fontSize: 16, bold: true, alignment: 'right' } },
    {% endif %}
    {% if FINANCIALS.payments.subHire.ledger|length > 0 and project.projectsTypes_config_finance == 1 and GET['subHires']  %}
        { text: {{ DOCUMENTS.labels.additionalHires|jsString }}, style: { fontSize: 20, bold: true }, pageBreak: 'before' },
        { 
            table: {
                widths: ['auto', '*'{% if GET['prices'] %},'auto','auto'{% endif %}],
                body: [
                    {% set currentSupplier = "" %}
                    {% for payment in FINANCIALS.payments.subHire.ledger %}
                    {% if currentSupplier != payment.payments_supplier %}
                        {% set currentSupplier = payment.payments_supplier %}
                        [{ 
                            text: "{{ payment.payments_supplier|escape("js") }}", 
                            style: { bold: true },
                            fillColor: '#F5F5F5',
                            colSpan: {{ GET['prices'] ? 4 : 2 }},
                            margin: 3
                        },
                        {% for i in range(2, (GET['prices'] ? 4 : 2)) %}{},{% endfor %}
                        ],
                    {% endif %}
                    [
                        "{{ payment.payments_quantity > 1 ? payment.payments_quantity ~ "x" : "" }}",
                        "{{ payment.payments_comment|escape("js") }}",
                        {% if GET['prices'] %}
                            {
                                text: "{{ payment.payments_amount|money|escape("js") }}",
                                style: {alignment: 'right'}
                            },
                            {
                                text: "{{ payment.payments_amountTotal|money|escape("js") }}",
                                style: {alignment: 'right'}
                            },
                        {% endif %}
                    ],
                    {% endfor %}
                ],
            },
            layout: 'noBorders',
            margin: [ 0, 10, 0, 10 ]
        },
        {% if GET['prices'] %}
        {
            columns: [
                {
                    width: '*',
                    text: 'Total: ',
                    style: { bold: true, alignment: 'right' },
                    margin: [ 0, 0, 5, 0 ]
                },
                {
                    width: 'auto',
                    text: "{{ FINANCIALS.payments.subHire.total|money|escape("js") }}",
                },
                
            ]
        },
        {% endif %}
    {% endif %}
    {% if FINANCIALS.payments.sales.ledger|length > 0 and project.projectsTypes_config_finance == 1 and GET['sales'] %}
        { text: {{ DOCUMENTS.labels.sales|jsString }}, style: { fontSize: 20, bold: true } },
        { 
            table: {
                widths: ['auto', '*'{% if GET['prices'] %},'auto','auto'{% endif %}],
                body: [
                    {% set currentSupplier = "" %}
                    {% for payment in FINANCIALS.payments.sales.ledger %}
                    {% if currentSupplier != payment.payments_supplier %}
                        {% set currentSupplier = payment.payments_supplier %}
                        [{ 
                            text: "{{ payment.payments_supplier|escape("js") }}", 
                            style: { bold: true },
                            fillColor: '#F5F5F5',
                            colSpan: {{ GET['prices'] ? 4 : 2 }},
                            margin: 3
                        },
                        {% for i in range(2, (GET['prices'] ? 4 : 2)) %}{},{% endfor %}
                        ],
                    {% endif %}
                    [
                        "{{ payment.payments_quantity > 1 ? payment.payments_quantity ~ "x" : "" }}",
                        "{{ payment.payments_comment|escape("js") }}",
                        {% if GET['prices'] %}
                            {
                                text: "{{ payment.payments_amount|money|escape("js") }}",
                                style: {alignment: 'right'}
                            },
                            {
                                text: "{{ payment.payments_amountTotal|money|escape("js") }}",
                                style: {alignment: 'right'}
                            },
                        {% endif %}
                    ],
                    {% endfor %}
                ],
            },
            layout: 'noBorders',
            margin: [ 0, 10, 0, 10 ]
        },
        {% if GET['prices'] %}
        {
            columns: [
                {
                    width: '*',
                    text: 'Total: ',
                    style: { bold: true, alignment: 'right' },
                    margin: [ 0, 0, 5, 0 ]
                },
                {
                    width: 'auto',
                    text: "{{ FINANCIALS.payments.sales.total|money|escape("js") }}",
                },
                
            ]
        },
        {% endif %}
    {% endif %}
    {% if project.projectsTypes_config_finance == 1 and FINANCIALS.payments.staff.ledger|length > 0 and GET['staff'] %}
        { text: {{ DOCUMENTS.labels.staff|jsString }}, style: { fontSize: 20, bold: true } },
        { 
            table: {
                widths: ['auto', '*'{% if GET['prices'] %},'auto','auto'{% endif %}],
                body: [
                    {% set currentSupplier = "" %}
                    {% for payment in FINANCIALS.payments.staff.ledger %}
                    {% if currentSupplier != payment.payments_supplier %}
                        {% set currentSupplier = payment.payments_supplier %}
                        [{ 
                            text: "{{ payment.payments_supplier|escape("js") }}", 
                            style: { bold: true },
                            fillColor: '#F5F5F5',
                            colSpan: {{ GET['prices'] ? 4 : 2 }},
                            margin: 3
                        },
                        {% for i in range(2, (GET['prices'] ? 4 : 2)) %}{},{% endfor %}
                        ],
                    {% endif %}
                    [
                        "{{ payment.payments_quantity > 1 ? payment.payments_quantity ~ "x" : "" }}",
                        "{{ payment.payments_comment|escape("js") }}",
                        {% if GET['prices'] %}
                            {
                                text: "{{ payment.payments_amount|money|escape("js") }}",
                                style: {alignment: 'right'}
                            },
                            {
                                text: "{{ payment.payments_amountTotal|money|escape("js") }}",
                                style: {alignment: 'right'}
                            },
                        {% endif %}
                    ],
                    {% endfor %}
                ],
            },
            layout: 'noBorders',
            margin: [ 0, 10, 0, 10 ]
        },
        {% if GET['prices'] %}
        {
            columns: [
                {
                    width: '*',
                    text: 'Total: ',
                    style: { bold: true, alignment: 'right' },
                    margin: [ 0, 0, 5, 0 ]
                },
                {
                    width: 'auto',
                    text: "{{ FINANCIALS.payments.staff.total|money|escape("js") }}",
                },
                
            ]
        },
        {% endif %}
    {% endif %}
    {% if GET['finance'] and "PROJECTS:PROJECT_PAYMENTS:VIEW"|instancePermissions and project.projectsTypes_config_finance == 1 %}
    { text: {{ DOCUMENTS.labels.summary|jsString }}, style: { fontSize: 20, bold: true }, margin: [ 0, 20, 0, 5 ] },
    {
        table: {
            widths: [ "35%", "15%", "35%", "15%"],
            body: [
                [
                    { text: "Equipment SubTotal" },
                    { text: "{{ FINANCIALS.prices.subTotal|money|escape("js") }}", style: { alignment: 'right' } },
                    { text: "Sales" },
                    { text: "{{ FINANCIALS.payments.sales.total|money|escape("js") }}", style: { alignment: 'right' } },
                ],
                [
                    { text: "{% if FINANCIALS.prices.discounts|moneyPositive %}Discounts{% else %}Adjustments{% endif %}" },
                    { text: "{% if FINANCIALS.prices.discounts|moneyPositive %}-{{ FINANCIALS.prices.discounts|money|escape("js") }}{% else %}None{% endif %}", style: { alignment: 'right' } },
                    { text: "Staffing" },
                    { text: "{{ FINANCIALS.payments.staff.total|money|escape("js") }}", style: { alignment: 'right' } },
                ],
                [
                    { text: "Equipment Total", style: { bold: true } },
                    { text: "{{ FINANCIALS.prices.total|money|escape("js") }}", style: { alignment: 'right' } },
                    { text: "Sub Hires" },
                    { text: "{{ FINANCIALS.payments.subHire.total|money|escape("js") }}", style: { alignment: 'right' } },
                ],
                {% if GET['type'] == "invoice" %}
                [
                    { text: "" },
                    { text: "" },
                    { text: "SubTotal", style: { bold: true } },
                    { text: "{{ FINANCIALS.payments.subTotal|money|escape("js") }}", style: { alignment: 'right' } },
                ],
                [
                    { text: "" },
                    { text: "" },
                    { text: "Payments Received to Date" },
                    { text: "-{{ FINANCIALS.payments.received.total|money|escape("js") }}", style: { alignment: 'right' } },
                ],
                {% endif %}
                [
                    { text: "" },
                    { text: "" },
                    { text: {{ (GET['type'] == 'quote' ? DOCUMENTS.labels.grandTotal : DOCUMENTS.labels.grandTotalOutstanding)|jsString }}, style: { bold: true } },
                    { text: "{{ FINANCIALS.payments.total|money|escape("js") }}", style: { alignment: 'right' } },
                ],
            ],
        },
        layout: 'noBorders',
    },
    {% endif %}
    {% if GET['paymentTerms'] and GET['type'] == 'deliveryNote' and DOCUMENTS.deliveryNoteFooter != "" %}
    {
        table: {
            widths: [ "100%"],
            body: [[
                { text: "{{ DOCUMENTS.deliveryNoteFooter|escape("js") }}", margin: 5 }
            ]],
        },
        fillColor: '#F5F5F5',
        layout: 'noBorders',
        margin: [ 0, 10, 0, 0 ]
    },
    {% endif %}
    {% if GET['paymentTerms'] and GET['type'] != 'deliveryNote' and (GET['type'] == 'quote' ? USERDATA.instance.instances_quoteTerms : USERDATA.instance.instances_termsAndPayment)|striptags|trim != "" %}
    {
        table: {
            widths: [ "100%"],
            body: [[
                { text: "{{ GET['type'] == 'quote' ? USERDATA.instance.instances_quoteTerms|striptags|escape("js") : USERDATA.instance.instances_termsAndPayment|replace({"</p>":"\n", "<br/>":"\n"})|striptags|escape("js") }}", margin: 5 }
            ]],
        },
        fillColor: '#F5F5F5',
        layout: 'noBorders',
        margin: [ 0, 10, 0, 0 ]
    },
    {% endif %}
    {% if DOCUMENTS.signature[documentType] != "" %}
    {
        columns: [
            { text: {{ (DOCUMENTS.signature[documentType] ~ ':')|jsString }}, width: 'auto' },
            { canvas: [ { type: 'line', x1: 0, y1: 11, x2: 140, y2: 11, lineWidth: 0.5 } ], width: 140 },
            { text: {{ (DOCUMENTS.labels.signature ~ ':')|jsString }}, width: 'auto' },
            { canvas: [ { type: 'line', x1: 0, y1: 11, x2: 140, y2: 11, lineWidth: 0.5 } ], width: 140 },
            { text: {{ (DOCUMENTS.labels.date ~ ':')|jsString }}, width: 'auto' },
            { canvas: [ { type: 'line', x1: 0, y1: 11, x2: 70, y2: 11, lineWidth: 0.5 } ], width: 70 },
        ],
        columnGap: 6,
        margin: [ 0, 40, 0, 0 ],
        unbreakable: true
    },
    {% endif %}