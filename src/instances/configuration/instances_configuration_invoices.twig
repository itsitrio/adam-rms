{% extends "assets/template.twig" %}
{% block content %}
<div class="row">
    <div class="col-12">
        <div class="card">
			<div class="card-header">
				<ul class="nav nav-pills">
					<li class="nav-item"><a class="nav-link" href="{{CONFIG.ROOTURL}}/instances/navigation.php"><i class="fas fa-arrow-left"></i> Back to Settings</span></a></li>
					{% if "PROJECTS:PROJECT_TYPES:VIEW"|instancePermissions %}
                    <li class="nav-item"><a class="nav-link" href="{{CONFIG.ROOTURL}}/instances/projectTypes.php">Project Types</a></li>
                    {% endif %}
					{% if "PROJECTS:PROJECT_STATUSES:VIEW"|instancePermissions %}
					<li class="nav-item"><a class="nav-link" href="{{CONFIG.ROOTURL}}/instances/projectStatuses.php">Project Statuses</a></li>
                    {% endif %}
					{% if "BUSINESS:BUSINESS_SETTINGS:VIEW"|instancePermissions %}
					<li class="nav-item"><a class="nav-link" href="{{CONFIG.ROOTURL}}/instances/configuration/asset-status.php">Asset Statuses</a></li>
					<li class="nav-item"><a class="nav-link active" href="{{CONFIG.ROOTURL}}/instances/configuration/invoices.php">Invoices</a></li>
                    {% endif %}
				</ul>
			</div>
		</div>
    </div>
</div>
<div class="row">
    <div class="col-12 col-md-8 offset-md-2">
        <div class="card ">
                <div class="card-header">
                    <h3 class="card-title">Project Invoice Footer</h3>
                </div>
                <div class="card-body">
                    <div class="form-group">
                        <label for="instances_quoteTerms">Quotation Footer</label>
                        <textarea class="form-control" id="instances_quoteTerms" placeholder="Place some text here" style="width: 100%; height: 200px; font-size: 14px; line-height: 18px; border: 1px solid #dddddd; padding: 10px;">{{ USERDATA.instance.instances_quoteTerms }}</textarea>
                    </div>
                    <div class="form-group">
                        <label for="instances_termsAndPayment">Invoice Footer</label>
                        <textarea class="form-control" id="instances_termsAndPayment" placeholder="Place some text here" style="width: 100%; height: 200px; font-size: 14px; line-height: 18px; border: 1px solid #dddddd; padding: 10px;">{{ USERDATA.instance.instances_termsAndPayment }}</textarea>
                    </div>
                </div>
                <div class="card-footer">
                    {% if "BUSINESS:BUSINESS_SETTINGS:EDIT"|instancePermissions %}
                    <button id="saveTermsAndPayment" class="btn btn-default">Save</button>
                    {% endif %}
                </div>
            <script>
                $(document).ready(function() {
                    {% if "BUSINESS:BUSINESS_SETTINGS:EDIT"|instancePermissions %}
                    $('#saveTermsAndPayment').on('click', function() {
                        ajaxcall("instances/editInstance.php", {
                            'formData': [
                                { 'name': 'instances_termsAndPayment','value':$('#instances_termsAndPayment').val() },
                                { 'name': 'instances_quoteTerms','value':$('#instances_quoteTerms').val() }
                            ]
                        }, function (data) {
                            location.reload();
                        }, false);
                    });
                    {% endif %}
                });
            </script>
        </div>
        {% set documents = documentSettings() %}
        <div class="card">
            <form id="documentSettings">
                <div class="card-header">
                    <h3 class="card-title">Generated Documents</h3>
                </div>
                <div class="card-body">
                    <div class="form-group">
                        <label>Page Size</label>
                        <select class="form-control" name="pageSize">
                            <option value="A4" {{ documents.pageSize == 'A4' ? 'selected' }}>A4</option>
                            <option value="LETTER" {{ documents.pageSize == 'LETTER' ? 'selected' }}>US Letter</option>
                        </select>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label>Invoices are called</label>
                            <input type="text" class="form-control" name="name_invoice" maxlength="50" value="{{ documents.names.invoice }}" placeholder="Invoice">
                        </div>
                        <div class="form-group col-md-4">
                            <label>Quotes are called</label>
                            <input type="text" class="form-control" name="name_quote" maxlength="50" value="{{ documents.names.quote }}" placeholder="Quotation">
                        </div>
                        <div class="form-group col-md-4">
                            <label>Delivery notes are called</label>
                            <input type="text" class="form-control" name="name_deliveryNote" maxlength="50" value="{{ documents.names.deliveryNote }}" placeholder="Delivery Note">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>Page header text (top left)</label>
                            <input type="text" class="form-control" name="headerText" maxlength="100" value="{{ documents.headerText }}" placeholder="{{ USERDATA.instance.instances_name }}">
                        </div>
                        <div class="form-group col-md-6">
                            <label>Page footer text (bottom right)</label>
                            <input type="text" class="form-control" name="footerText" maxlength="100" value="{{ documents.footerText }}" placeholder="Generated by AdamRMS">
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="form-check">
                            <input type="hidden" name="firstPage" value="false">
                            <input class="form-check-input" type="checkbox" name="firstPage" value="true" id="documentsFirstPage" {{ documents.firstPage ? 'checked' }}>
                            <label class="form-check-label" for="documentsFirstPage">Show the page header and footer on the first page too</label>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Delivery Note Footer</label>
                        <textarea class="form-control" name="deliveryNoteFooter" rows="4" maxlength="5000" placeholder="For example, a line for whoever receives the equipment to sign">{{ documents.deliveryNoteFooter }}</textarea>
                    </div>
                    <p class="text-muted mb-0">To choose which options are ticked to start with for each type of document, set them when generating one from a project and click "Save these options as the default".</p>
                </div>
                <div class="card-footer">
                    {% if "BUSINESS:BUSINESS_SETTINGS:EDIT"|instancePermissions %}
                    <button type="submit" class="btn btn-default">Save</button>
                    {% endif %}
                </div>
            </form>
            {% if "BUSINESS:BUSINESS_SETTINGS:EDIT"|instancePermissions %}
            <script>
                $(document).ready(function() {
                    $("#documentSettings").on("submit", function(e) {
                        e.preventDefault();
                        var data = {};
                        $.each($("#documentSettings").serializeArray(), function (i, field) { data[field.name] = field.value; });
                        ajaxcall("instances/editInstanceDocuments.php", data, function (data) {
                            location.reload();
                        }, false);
                    });
                });
            </script>
            {% endif %}
        </div>
   </div>
</div>
{% endblock %}