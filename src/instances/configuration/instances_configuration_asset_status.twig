{% extends "assets/template.twig" %}
{% block htmlIncludes %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js" integrity="sha256-KM512VNnjElC30ehFwehXjx1YCHPiQkOPmqnrWtpccM=" crossorigin="anonymous"></script>
{% endblock %}
{% block content %}
<div class="row">
    <div class="col-12">
        <div class="card">
			<div class="card-header">
				<ul class="nav nav-pills">
					<li class="nav-item"><a class="nav-link" href="{{CONFIG.ROOTURL}}/instances/navigation.php"><i class="fas fa-arrow-left"></i> Back to Settings</span></a></li>
					{% if "PROJECTS:PROJECT_TYPES:VIEW"|instancePermissions %}
                    <li class="nav-item"><a class="nav-link" href="{{CONFIG.ROOTURL}}/instances/projectTypes.php">Project Types</a></li>
                    {% endif %}
					{% if "PROJECTS:PROJECT_STATUSES:VIEW"|instancePermissions %}
					<li class="nav-item"><a class="nav-link" href="{{CONFIG.ROOTURL}}/instances/projectStatuses.php">Project Statuses</a></li>
                    {% endif %}
					{% if "BUSINESS:BUSINESS_SETTINGS:VIEW"|instancePermissions %}
					<li class="nav-item"><a class="nav-link active" href="{{CONFIG.ROOTURL}}/instances/configuration/asset-status.php">Asset Statuses</a></li>
					<li class="nav-item"><a class="nav-link" href="{{CONFIG.ROOTURL}}/instances/configuration/invoices.php">Invoices</a></li>
                    {% endif %}
				</ul>
			</div>
		</div>
    </div>
</div>
<div class="row">
    <div class="col-12 col-lg-8 offset-lg-2">
        <div class="card">
            <style>
    .assetStatusRow .assetStatusNameCell { flex: 1 1 12rem; min-width: 0; }
    .assetStatusRow .assetStatusEffectCell { flex: 0 0 12rem; }
    /* On a phone the name keeps the top line with the handle and delete button, and the effect goes underneath, full width */
    @media (max-width: 767.98px) {
        .assetStatusRow .assetStatusHandleCell { order: 1; }
        .assetStatusRow .assetStatusNameCell { order: 2; flex: 1 1 0; }
        .assetStatusRow .assetStatusDeleteCell { order: 3; border-left: 0 !important; }
        .assetStatusRow .assetStatusEffectCell { order: 4; flex: 1 1 100%; padding-top: 0; }
    }
</style>
            <form id="asstStatuses">
                <div class="card-header">
                    <h3 class="card-title">Asset Status</h3>
                </div>
                <div class="card-body">
                    <table class="table table-borderless" id="statusTable">
                        {% for status in USERDATA.instance['assetStatus'] %}
                            <tbody value="{{ status.assetsAssignmentsStatus_id }}">
                                <tr class="row border align-items-center assetStatusRow">
                                    {% if "BUSINESS:BUSINESS_SETTINGS:EDIT"|instancePermissions %}
                                    <td class="border-right assetStatusHandleCell">
                                        <span class="handle">
                                            <i class="fas fa-ellipsis-v"></i>
                                            <i class="fas fa-ellipsis-v"></i>
                                        </span>
                                    </td>
                                    {% endif %}
                                    <td class="assetStatusNameCell">
                                        <input type="text" class="assetStatusName form-control" name="{{ status.assetsAssignmentsStatus_id }}" value="{{ status.assetsAssignmentsStatus_name }}" />
                                    </td>
                                    <td class="assetStatusEffectCell">
                                        <select class="assetStatusEffect form-control" data-status="{{ status.assetsAssignmentsStatus_id }}" title="What this status means for where the gear is. Holds on an asset can stop it reaching a status that leaves the warehouse, or going past one - unless it ends on a status marked as returning it to the warehouse." {% if not ("BUSINESS:BUSINESS_SETTINGS:EDIT"|instancePermissions) %}disabled{% endif %}>
                                            <option value="">No effect</option>
                                            <option value="LEAVES_WAREHOUSE" {{ status.assetsAssignmentsStatus_effect == "LEAVES_WAREHOUSE" ? "selected" : "" }}>Leaves warehouse</option>
                                            <option value="RETURNS_TO_WAREHOUSE" {{ status.assetsAssignmentsStatus_effect == "RETURNS_TO_WAREHOUSE" ? "selected" : "" }}>Returns to warehouse</option>
                                        </select>
                                    </td>
                                    <td class="text-right border-left assetStatusDeleteCell">
                                        <button type="button" class="btn btn-danger" onclick="removeStatus({{ status.assetsAssignmentsStatus_id }})"><i class="fa fa-trash"></i></button>
                                    </td>
                                </tr>
                            </tbody>
                        {% endfor %}
                    </table>
                </div>
                <div class="card-footer">
                    {% if "BUSINESS:BUSINESS_SETTINGS:EDIT"|instancePermissions %}
                        <button type="button" class="btn btn-default" id="newStatus">Add Row</button>
                    {% endif %}
                </div>
            </form>
            {% if "BUSINESS:BUSINESS_SETTINGS:EDIT"|instancePermissions %}
            <script>
                $(document).ready(function () {
                    $("#statusTable").sortable({
                        handle: ".handle",
                        connectWith: "tr",
                        update: function( event, ui ){
                            ajaxcall("instances/assetAssignmentStatus/reorder.php", {
                                "order": $("#statusTable").sortable('toArray', {attribute: 'value'})
                            }, null, true);
                        }
                    });
                    $("#newStatus").on("click", function () {
                        bootbox.prompt({
                            title: "Create New Asset Status",
                            inputType: "text",
                            callback: function (result) {
                                ajaxcall(
                                    "instances/assetAssignmentStatus/new.php",
                                    {"statusName": result, "statusOrder": {{ (USERDATA.instance['assetStatus']|last).assetsAssignmentsStatus_order + 1 }}},
                                    function (returned) {
                                        if (returned['result']) {
                                            window.location.reload();
                                        }
                                    },
                                    true
                                );
                            }
                        });
                    });
                    $(".assetStatusEffect").on("change", function () {
                        ajaxcall(
                            "instances/assetAssignmentStatus/edit.php",
                            {"statusName": $('.assetStatusName[name="' + $(this).data("status") + '"]').val(), "statusId": $(this).data("status"), "statusEffect": $(this).val()},
                            null,
                            true
                        );
                    });
                    $(".assetStatusName").on("focusout", function () {
                        ajaxcall(
                            "instances/assetAssignmentStatus/edit.php",
                            {"statusName": $(this)[0].value, "statusId": $(this)[0].name},
                            null,
                            true
                        );
                    });
                });
                function removeStatus(statusID){
                    ajaxcall("instances/assetAssignmentStatus/delete.php",
                        {"statusId": statusID},
                        function (returned) {
                            if (returned['result']) {
                                window.location.reload();
                            }
                        },
                        true
                    );
                }
            </script>
            {% endif %}
        </div>
   </div>
</div>
{% endblock %}